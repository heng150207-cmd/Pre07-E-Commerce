{
  "name": "cartora",
  "version": "2.0.0",
  "description": "Cartora — e-commerce landing page (Tailwind CSS + JavaScript)",
  "main": "index.html",
  "scripts": {
    "start": "live-server --port=5500",
    "dev": "live-server --port=5500",
    "build": "npx @tailwindcss/cli -i ./src/input.css -o ./src/output.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./src/input.css -o ./src/output.css --watch"
  },
  "keywords": ["ecommerce", "landing-page", "tailwindcss", "javascript"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "live-server": "^1.2.2",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/cli": "^4.1.0"
  }
}
